# The only hosted service: Gemini writes the answers and, once per iMac page,
# describes its charts. Everything else runs locally.
GEMINI_API_KEY=replace-me
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Tried in order when the model above is out of free-tier quota or busy
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Optional overrides
# ADV_EMBED_MODEL=BAAI/bge-small-en-v1.5   # changing it needs ADV_EMBED_DIM and a re-ingest
# ADV_EMBED_DIM=384
# ADV_EMBED_BATCH=8
# EMBED_CACHE_DIR=/tmp/fastembed_cache
